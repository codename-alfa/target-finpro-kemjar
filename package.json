{
  "name": "finvault-b20",
  "version": "1.0.0",
  "description": "FinVault Portal - Custom Penetration Testing Target for Topic B20 (No API Authentication + Insecure Change Password Feature)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node -e \"process.env.NEXT_DEV='true'; require('./server').startServer().catch(e => { console.error(e); process.exit(1); })\"",
    "build": "node -e \"process.env.UNIFIED_SERVER='true'; require('child_process').execSync('npm --prefix frontend run build', { stdio: 'inherit' })\"",
    "start:vuln": "node -e \"process.env.SEC_MODE='VULNERABLE'; require('./server').startServer().catch(e => { console.error(e); process.exit(1); })\"",
    "start:secure": "node -e \"process.env.SEC_MODE='SECURE'; require('./server').startServer().catch(e => { console.error(e); process.exit(1); })\"",
    "seed": "node scripts/seed.js",
    "verify": "node scripts/verify_pentest_stages.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:start": "npm --prefix frontend run start",
    "frontend:lint": "npm --prefix frontend run lint"
  },
  "keywords": [
    "pentest",
    "kemjar",
    "b20",
    "security",
    "express",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.3"
  }
}
